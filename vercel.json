{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(index\\.html)?",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|SkypeUriPreview|Pinterestbot|redditbot|Iframely|Embedly|vkShare).*" }],
      "dest": "/api/partilha"
    },
    {
      "src": "/(index\\.html)?",
      "has": [{ "type": "query", "key": "partilha" }],
      "dest": "/api/partilha"
    }
  ]
}
